// For config options see https://aka.ms/devcontainer.json
{
	"name": "re-color",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// vite.config.ts listens on 0.0.0.0:5173
	"forwardPorts": [
		5173
	],
	"portsAttributes": {
		"5173": {
			"label": "Vite dev server",
			"onAutoForward": "openPreview"
		}
	},
	"postCreateCommand": "bun install --frozen-lockfile",
	"customizations": {
		"vscode": {
			"extensions": [
				"svelte.svelte-vscode",
				"bradlc.vscode-tailwindcss",
				"ardenivanov.svelte-intellisense",
				"ms-azuretools.vscode-docker",
				"eamodio.gitlens",
				"stivo.tailwind-fold"
			]
		}
	}
	// "remoteUser": "root"
}